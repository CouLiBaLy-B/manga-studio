# Copiez ce fichier vers .env pour démarrer la pile Docker de façon sécurisée.
# Ne versionnez jamais le fichier .env réel.

# Générez une valeur longue et aléatoire, puis saisissez-la dans le dashboard
# uniquement pour les opérations protégées (génération et édition).
MANGA_STUDIO_API_KEY=replace-with-a-long-random-secret

# Origines navigateur explicitement autorisées, séparées par des virgules.
MANGA_STUDIO_CORS_ORIGINS=http://localhost:3000

# Limites de protection optionnelles.
MANGA_STUDIO_MAX_UPLOAD_BYTES=10485760
MANGA_STUDIO_MAX_TALE_CHARACTERS=100000
