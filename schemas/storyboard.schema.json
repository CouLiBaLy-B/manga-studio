{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryboardSchema",
  "description": "Schéma de validation canonique pour le Storyboard du mode Conte animé",
  "type": "object",
  "required": ["schema_version", "story_id", "segments"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordre",
          "scene_id",
          "titre",
          "source_refs",
          "frame",
          "characters_present",
          "reference_character_ids",
          "audio_script",
          "prompt_ia",
          "duree_s",
          "emotion",
          "plan",
          "decor",
          "continuity_in",
          "continuity_out",
          "transition"
        ],
        "properties": {
          "ordre": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string",
            "pattern": "^scene_[0-9]{3,}$"
          },
          "titre": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["paragraph_index", "excerpt"],
              "properties": {
                "paragraph_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          },
          "frame": {
            "type": "string",
            "minLength": 1
          },
          "characters_present": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audio_script": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["speaker", "kind", "text"],
              "properties": {
                "speaker": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["dialogue", "narration", "sound_effect"]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "prompt_ia": {
            "type": "string",
            "minLength": 1
          },
          "duree_s": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 30.0
          },
          "emotion": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "decor": {
            "type": "string"
          },
          "continuity_in": {
            "type": "string"
          },
          "continuity_out": {
            "type": "string"
          },
          "transition": {
            "type": "object",
            "required": ["type", "duration_s"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["fade", "cut", "dissolve", "none"]
              },
              "duration_s": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 2.0
              }
            }
          }
        }
      }
    }
  }
}
