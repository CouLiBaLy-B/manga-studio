{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QCReportSchema",
  "description": "Schéma de validation canonique pour les rapports de Contrôle Qualité (QC)",
  "type": "object",
  "required": [
    "segment_id",
    "attempt",
    "status",
    "duration_ok",
    "audio_present",
    "dialogue_wer",
    "visual_similarity",
    "attribute_checks",
    "issues",
    "recommendation"
  ],
  "properties": {
    "segment_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "needs_review"]
    },
    "duration_ok": {
      "type": "boolean"
    },
    "audio_present": {
      "type": "boolean"
    },
    "dialogue_wer": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "visual_similarity": {
      "type": "object",
      "required": ["model", "score", "threshold"],
      "properties": {
        "model": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "attribute_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["accept", "retry", "flag_review"]
    }
  }
}
